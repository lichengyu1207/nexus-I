# 应用配置
APP_ENV=development
APP_PORT=8080

# 数据库
DB_TYPE=sqlite
SQLITE_PATH=./data/dev.db

# Redis（可选，Docker 启动）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO 对象存储（可选）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=nexus-files

# JWT
JWT_SECRET=local-dev-secret-do-not-use-in-prod
JWT_EXPIRE=24h

# 日志
LOG_LEVEL=debug
